{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/migrate-mongo/bin/migrate-mongo.js up -f migrate-mongo-config.mjs",
    "db:status": "node --env-file-if-exists=.env ./node_modules/migrate-mongo/bin/migrate-mongo.js status -f migrate-mongo-config.mjs",
    "db:down": "node --env-file-if-exists=.env ./node_modules/migrate-mongo/bin/migrate-mongo.js down -f migrate-mongo-config.mjs",
    "db:seed": "node --env-file-if-exists=.env dist/seed.js",
    "db:create": "node ./node_modules/migrate-mongo/bin/migrate-mongo.js create -f migrate-mongo-config.mjs"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.11.4",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "mongodb": "^7.8.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
