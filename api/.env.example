# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:4000

# Database (used from T008): mock = in-process MongoDB, real = MONGODB_URI
DB_MODE=mock
MONGODB_URI=
MOCK_DB_PATH=.data/mongo
# Fixed port used when MOCK_DB_PATH is set (persistent data remembers it)
MOCK_DB_PORT=27018
# Optional: pin the MongoDB version the mock downloads (default chosen by mongodb-memory-server)
MOCK_DB_VERSION=

# Auth (generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Password hashing (argon2id)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# First admin, created only when the users collection is empty.
# Leave SEED_ADMIN_PASSWORD empty to get a random password printed once on first start.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Administrator

# Login rate limiting: requests per IP per window, and failed logins per username+IP per window (seconds)
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=900

# Set when the API runs behind a reverse proxy so the real client IP is used: true, a hop count like 1, or a subnet like loopback
TRUST_PROXY=false
